# Copia este archivo .env.example a .env.local y ajústalo con tus credenciales.

# ==========================================
# BASE DE DATOS (Docker & Drizzle ORM)
# ==========================================

# Credenciales para el contenedor de PostgreSQL (usadas en docker compose)
POSTGRES_USER=chartmaker
POSTGRES_PASSWORD=tu_contraseña_segura
POSTGRES_DB=chartmaker

# URL de conexión para Drizzle ORM y Next.js
# Formato: postgresql://[usuario]:[contraseña]@[host]:[puerto]/[nombre_bd]
DATABASE_URL=postgresql://chartmaker:tu_contraseña_segura@localhost:5432/chartmaker


# Autenticación (Better Auth)
# Secreto: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Proveedor OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correos que reciben el rol admin al registrarse (separados por comas)
ADMIN_EMAILS=